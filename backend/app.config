<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Here would be runtime values: mail-server, crypted passwords and api-keys, etc. In real life, you probably want to encrypt the settings and restrict the access e.g. via sub-repository. -->
    <!-- Connection-string could have MARS setting: MultipleActiveResultSets=False -->
    <add key="RuntimeDBConnectionString" value="Data Source=localhost;Initial Catalog=companyweb; Integrated Security=True;TrustServerCertificate=True;Persist Security Info=False;Encrypt=True;Connection Timeout=60;Application Name=WebsitePlayground" />
    <add key="DomainForwarding" value="" />
    <add key="WebServerIp" value="*" />
    <add key="WebServerIpSSL" value="*" />
    <!-- Comma separated list of ports. SSL needs certificate on the server. -->
    <add key="WebServerPorts" value="7050" />
    <add key="WebServerPortsSSL" value="443" />
    <!-- Logging level: debug / warn / error -->
    <add key="LogLevel" value="debug" />
    <add key="WebServerDebug" value="true" />
    <add key="WebServerFolder" value="../../frontend/dist" />
    <!-- Sign-in: Local (email and password in the users table), Cognito, Auth0 or Oidc (any other OpenID Connect provider).
         External providers redirect back to /signin-oidc and, after sign-out, to /login.html: register both with the provider. -->
    <add key="AuthProvider" value="Local" />
    <!-- Cognito: the user pool id, such as eu-west-2_AbC123. The pool needs a Hosted UI domain. -->
    <add key="AuthCognitoUserPoolId" value="" />
    <!-- Auth0: the tenant domain, such as myapp.eu.auth0.com -->
    <add key="AuthDomain" value="" />
    <!-- Oidc: the issuer URL, such as https://login.microsoftonline.com/<tenant id>/v2.0 -->
    <add key="AuthAuthority" value="" />
    <add key="AuthClientId" value="" />
    <!-- Keep the secret out of source control in real use. Empty for a public client, which then relies on PKCE alone. -->
    <add key="AuthClientSecret" value="" />
    <!-- Auth0: the API identifier, when the site calls an API with the access token. Optional. -->
    <add key="AuthAudience" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.1" />
  </startup>
  <runtime>
    <gcServer enabled="true"/>
  </runtime>
</configuration>
